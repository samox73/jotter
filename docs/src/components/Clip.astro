---
// A looping feature clip recorded by docs/media/record.nu into public/media/.
// Until a clip has been recorded the component renders nothing, so pages can
// reference clips before the recording rig produces them.
import { existsSync } from 'node:fs';

interface Props {
  name: string;
  caption?: string;
  /** what the clip shows, for screen readers; defaults to the caption */
  alt?: string;
}
const { name, caption, alt } = Astro.props;
const base = `${import.meta.env.BASE_URL}media/${name}`;
// relative to docs/ (where astro runs), not this file: it's bundled at build time
const onDisk = (ext: string) => existsSync(`${process.cwd()}/public/media/${name}.${ext}`);
const poster = onDisk('webp') ? `${base}.webp` : undefined;
---

{
  (onDisk('webm') || onDisk('mp4')) && (
    <figure class="media">
      <video class="shot" autoplay loop muted playsinline preload="metadata" poster={poster} aria-label={alt ?? caption ?? name}>
        {onDisk('webm') && <source src={`${base}.webm`} type="video/webm" />}
        {onDisk('mp4') && <source src={`${base}.mp4`} type="video/mp4" />}
      </video>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<script>
  // Reduced motion: no autoplay. Reloading shows the poster (the clip's last
  // frame, the finished result) with controls to play it on request.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const v of document.querySelectorAll<HTMLVideoElement>('video.shot')) {
      v.removeAttribute('autoplay');
      v.preload = 'none';
      v.controls = true;
      v.load();
    }
  }
</script>
