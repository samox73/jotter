---
// A looping feature clip recorded by docs/media/record.nu into public/media/.
// Until a clip has been recorded the component renders nothing, so pages can
// reference clips before the recording rig produces them.
import { existsSync } from 'node:fs';

interface Props {
  name: string;
  caption?: string;
}
const { name, caption } = Astro.props;
const base = `${import.meta.env.BASE_URL}media/${name}`;
const onDisk = (ext: string) => existsSync(new URL(`../../public/media/${name}.${ext}`, import.meta.url));
const poster = onDisk('png') ? `${base}.png` : undefined;
---

{
  (onDisk('webm') || onDisk('mp4')) && (
    <figure class="media">
      <video class="shot" autoplay loop muted playsinline preload="metadata" poster={poster} aria-label={caption ?? name}>
        {onDisk('webm') && <source src={`${base}.webm`} type="video/webm" />}
        {onDisk('mp4') && <source src={`${base}.mp4`} type="video/mp4" />}
      </video>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<script>
  // Reduced motion: no autoplay; show the poster with controls instead.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const v of document.querySelectorAll<HTMLVideoElement>('video.shot')) {
      v.pause();
      v.removeAttribute('autoplay');
      v.controls = true;
    }
  }
</script>
