   "source": [
    "## Decay\n",
    "\n",
    "A damped oscillation, $x(t) = e^{-\\gamma t}\\cos\\omega t$, with $\\gamma = 0.3$:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "t = np.linspace(0, 10, 500)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c2",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.plot(t, np.exp(-0.3 * t) * np.cos(4 * t))\n",
    "plt.show()"
   ]
  }
 ],
