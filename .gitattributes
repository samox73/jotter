# Recorded media goes through Git LFS, so re-recording a clip does not grow
# every clone. Not hero.gif: the README hotlinks it from
# raw.githubusercontent.com, which serves the LFS pointer instead of the file.
docs/public/media/*.mp4 filter=lfs diff=lfs merge=lfs -text
docs/public/media/*.webm filter=lfs diff=lfs merge=lfs -text
docs/public/media/*.webp filter=lfs diff=lfs merge=lfs -text
testing/**/*.png filter=lfs diff=lfs merge=lfs -text
testing/**/*.jpg filter=lfs diff=lfs merge=lfs -text
